# ============================================================
# FLORA FUSION — ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in your own Firebase project
# credentials. Never commit the real `.env` file to version control.
# ============================================================

# ---------- Firebase Client SDK (public, safe for browser) ----------
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to "true" only in local development to use Firebase Emulators
PUBLIC_USE_FIREBASE_EMULATORS=false

# Public site URL (used for password reset links, sitemap, etc.)
PUBLIC_SITE_URL=https://florafusion.vercel.app

# Public contact email displayed across the site
PUBLIC_CONTACT_EMAIL=florafusion11@gmail.com

# ---------- Firebase Admin SDK (private, server-only) ----------
# Generate this from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=your-project.appspot.com

# ---------- Security ----------
# Random 32+ character string used to sign internal session artifacts
SESSION_COOKIE_SECRET=replace-with-a-long-random-string

# ---------- Rate Limiting ----------
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
