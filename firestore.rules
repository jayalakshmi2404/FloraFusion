rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && currentRole() == 'admin';
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['fullName', 'email', 'role']) &&
        data.role in ['user', 'admin'] &&
        data.fullName is string &&
        data.fullName.size() >= 3 &&
        data.email is string;
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.role == 'user';
      allow update: if (isOwner(userId) &&
          request.resource.data.role == resource.data.role) ||
        isAdmin();
      allow delete: if false;

      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ---------- FLOWERS (public catalog, admin-managed) ----------
    match /flowers/{flowerId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() >= 5 &&
          request.resource.data.comment.size() <= 600;
        allow update, delete: if isAdmin();
      }
    }

    // ---------- PRODUCTS (public catalog, admin-managed) ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- COUPONS ----------
    match /coupons/{couponCode} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- FLOWER SUBMISSIONS ----------
    match /flower_submissions/{submissionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.flowerWeightGrams is number &&
        request.resource.data.flowerWeightGrams > 0 &&
        request.resource.data.status == 'Submitted';
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'Submitted');
      allow delete: if false;
    }

    // ---------- ORDERS (server-authored only, via Admin SDK) ----------
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }

    // ---------- NEWSLETTER SUBSCRIBERS (server-authored only) ----------
    match /newsletter_subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
